            color: white;
            text-align: center;
            padding: 2rem 1rem;
        }

        @media (max-width: 768px) {
            .hero-content h1 {
                font-size: 2.1rem;
            }
            .nav-links {
                display: none;
            }
        }
    </style>
</head>
