            height: 200px;
            background-color: #e9ecef;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #adb5bd;
            font-size: 0.9rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .menu-img-holder img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .menu-info {
            padding: 1.2rem;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .menu-title {
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            color: var(--primary-color);
        }

        .menu-desc {
            font-size: 0.9rem;
            color: #666;
            margin-bottom: 1rem;
        }

        .menu-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: auto;
        }

        .price {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--accent-color);
        }

        .btn-order-item {
            background-color: #25d366;
            color: white;
            padding: 8px 15px;
            border-radius: 20px;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        /* Location & Map Section */
        .location-section {
            background-color: #e9edc9;
            padding: 4rem 1.5rem;
        }

        .location-container {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
